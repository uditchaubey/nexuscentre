# Copy this file to .env and fill in your own keys. Never commit .env.

PORT=8080

# Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Optional — specialized modules degrade gracefully if left blank.
# TMDB (movies): https://www.themoviedb.org/settings/api
TMDB_API_KEY=
# GNews (news): https://gnews.io
GNEWS_API_KEY=
# RAWG (games): https://rawg.io/apidocs
RAWG_API_KEY=

# Spotify (music search + embedded player): https://developer.spotify.com/dashboard
# Create an app there, then copy its Client ID and Client Secret below.
# This uses the Client Credentials flow (catalog search only, no user login).
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
